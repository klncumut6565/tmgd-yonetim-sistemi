# Supabase Dashboard → Project Settings → API ekranından alınacak.
# Gerçek anahtarları .env.local içine kopyalayın; bu dosyayı (.example) Git'e
# güvenle commit edebilirsiniz, gerçek .env.local dosyasını ASLA commit etmeyin.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key'i ASLA frontend'e veya .env.local'e koymayın / paylaşmayın.

# Mobil belge tarama entegrasyonu (klncumut6565/tarayici_ios PWA'sı).
# Ayarlıysa Belge Takip'te "📷 Mobilden Tara" butonu görünür; ayarlı
# değilse buton hiç gösterilmez (bozuk bağlantı sunulmaz). Değeri,
# tarayici_ios'un deploy edildiği Vercel adresidir, sonunda / OLMADAN.
# Örnek: NEXT_PUBLIC_TARAYICI_URL=https://tarayici-ios.vercel.app
# Ayrıca database/migrations/040_belge_tarama_oturumlari.sql'in
# çalıştırılmış olması gerekir (bkz. README.md → Kurulum → Veritabanı).
NEXT_PUBLIC_TARAYICI_URL=
